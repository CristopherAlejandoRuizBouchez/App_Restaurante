@baseUrl = http://localhost:3000
@apiKey = sk_test_7db7aca9589122e0f259b5f8bedcfa582f5088f170caf596

# Pegá acá el "id" que devuelve el bloque "Crear pedido" (201)
@orderId = cms86rchc0007qkuxljiuirkl

### ========== SALUD ==========

### Health check
GET {{baseUrl}}/api/health

### ========== AUTENTICACIÓN ==========

### Login
POST {{baseUrl}}/api/internal/auth/login
Content-Type: application/json

{
  "email": "owner@demo.test",
  "password": "Demo1234!"
}

### Sesión actual
GET {{baseUrl}}/api/internal/auth/me

### Contraseña incorrecta (401)
POST {{baseUrl}}/api/internal/auth/login
Content-Type: application/json

{
  "email": "owner@demo.test",
  "password": "incorrecta"
}

### Email inválido (400)
POST {{baseUrl}}/api/internal/auth/login
Content-Type: application/json

{
  "email": "no-es-un-email",
  "password": "algo"
}

### Logout
POST {{baseUrl}}/api/internal/auth/logout

### ========== TENANT ==========

### Datos del restaurante
GET {{baseUrl}}/api/internal/restaurant

### Listar mesas
GET {{baseUrl}}/api/internal/tables

### ========== CATÁLOGO ==========

### Listar categorías
GET {{baseUrl}}/api/internal/categories

### Listar productos
GET {{baseUrl}}/api/internal/products

### Solo disponibles
GET {{baseUrl}}/api/internal/products?onlyAvailable=true






### ========== FLUJO DEL COMENSAL ==========

### 1. Escanear QR
POST {{baseUrl}}/api/public/session/ddecbf8d31

### 2. Ver el menú
GET {{baseUrl}}/api/public/menu

### 3. Crear pedido  --> COPIÁ EL "id" DE LA RESPUESTA A @orderId
POST {{baseUrl}}/api/public/orders
Content-Type: application/json

{
  "items": [
    { "productId": "cms70otc20004mouxb110dpe6", "quantity": 2 },
    { "productId": "cms70otc20006moux6yqrdmwu", "quantity": 1, "notes": "Sin cebolla" }
  ],
  "notes": "Mesa junto a la ventana"
}

### 4. Mis pedidos y total de la mesa
GET {{baseUrl}}/api/public/orders

### 5. Seguimiento de mi pedido
GET {{baseUrl}}/api/public/orders/{{orderId}}

### Producto inexistente (422)
POST {{baseUrl}}/api/public/orders
Content-Type: application/json

{
  "items": [{ "productId": "no-existe", "quantity": 1 }]
}

### Sin items (400)
POST {{baseUrl}}/api/public/orders
Content-Type: application/json

{
  "items": []
}






### ========== FLUJO DEL PERSONAL ==========

### Listar pedidos
GET {{baseUrl}}/api/internal/orders

### Solo pendientes
GET {{baseUrl}}/api/internal/orders?status=PENDING

### Detalle con historial
GET {{baseUrl}}/api/internal/orders/{{orderId}}

### Confirmar
PATCH {{baseUrl}}/api/internal/orders/{{orderId}}/status
Content-Type: application/json

{ "status": "CONFIRMED" }

### A preparación
PATCH {{baseUrl}}/api/internal/orders/{{orderId}}/status
Content-Type: application/json

{ "status": "PREPARING" }

### Listo
PATCH {{baseUrl}}/api/internal/orders/{{orderId}}/status
Content-Type: application/json

{ "status": "READY" }

### Entregado
PATCH {{baseUrl}}/api/internal/orders/{{orderId}}/status
Content-Type: application/json

{ "status": "DELIVERED" }

### TRANSICIÓN INVÁLIDA: volver a PREPARING (422)
PATCH {{baseUrl}}/api/internal/orders/{{orderId}}/status
Content-Type: application/json

{ "status": "PREPARING" }

### Cancelar (solo si no está en estado terminal)
POST {{baseUrl}}/api/internal/orders/{{orderId}}/cancel
Content-Type: application/json

{ "reason": "El cliente se retiró" }

### Cobrar
POST {{baseUrl}}/api/internal/orders/{{orderId}}/pay
Content-Type: application/json

{ "paymentMethod": "CASH" }

### Cobrar de nuevo (422 - ORDER_ALREADY_PAID)
POST {{baseUrl}}/api/internal/orders/{{orderId}}/pay
Content-Type: application/json

{ "paymentMethod": "CASH" }

### ========== API PÚBLICA v1 (Make) ==========

### Productos
GET {{baseUrl}}/api/v1/products
Authorization: Bearer {{apiKey}}

### Categorías
GET {{baseUrl}}/api/v1/categories
Authorization: Bearer {{apiKey}}

### Menú completo
GET {{baseUrl}}/api/v1/menu
Authorization: Bearer {{apiKey}}

### Listar pedidos
GET {{baseUrl}}/api/v1/orders
Authorization: Bearer {{apiKey}}

### Polling incremental (lo que usará Make)
GET {{baseUrl}}/api/v1/orders?updatedSince=2026-07-30T00:00:00.000Z
Authorization: Bearer {{apiKey}}

### Detalle de pedido
GET {{baseUrl}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{apiKey}}

### Cambiar estado desde Make
PATCH {{baseUrl}}/api/v1/orders/{{orderId}}/status
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{ "status": "CONFIRMED" }

### Sin API Key (401)
GET {{baseUrl}}/api/v1/products

### API Key inválida (401)
GET {{baseUrl}}/api/v1/products
Authorization: Bearer sk_test_incorrecta






### ========== IDEMPOTENCIA ==========

@tableId = cms6xodyp0004d8uxpm1srg1v
@productId = cms70otc2000cmouxt30z4gjb

### Listar mesas v1
GET {{baseUrl}}/api/v1/tables
Authorization: Bearer {{apiKey}}

### 1. Crear pedido desde Make
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Idempotency-Key: prueba-001

{ "tableId": "{{tableId}}", "items": [{ "productId": "{{productId}}", "quantity": 2 }] }

### 2. MISMA clave, mismo cuerpo -> mismo pedido
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Idempotency-Key: prueba-001

{ "tableId": "{{tableId}}", "items": [{ "productId": "{{productId}}", "quantity": 2 }] }

### 3. MISMA clave, cuerpo distinto -> 409
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Idempotency-Key: prueba-001

{ "tableId": "{{tableId}}", "items": [{ "productId": "{{productId}}", "quantity": 5 }] }

### 4. Clave nueva -> pedido distinto
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{apiKey}}
Content-Type: application/json
Idempotency-Key: prueba-002

{ "tableId": "{{tableId}}", "items": [{ "productId": "{{productId}}", "quantity": 1 }] }
















### ========== WEBHOOKS ==========

@cronSecret = 5SIxBYNnwdZ2N2r/C4J+1d7R6EYVfnBuiG0kF7m4mL0=

### Crear webhook (requiere login) — pegá tu URL de webhook.site
POST {{baseUrl}}/api/internal/integrations/webhooks
Content-Type: application/json

{
  "name": "Make - pruebas",
  "url": "https://webhook.site/061628db-dc27-4001-bbd8-d411eb5d90f5",
  "events": ["order.created", "order.status_changed", "order.cancelled"]
}

### Listar webhooks
GET {{baseUrl}}/api/internal/integrations/webhooks

### Despachar la cola manualmente
GET {{baseUrl}}/api/cron/webhooks
Authorization: Bearer {{cronSecret}}

### Ver entregas (reemplazá el ID del webhook)
GET {{baseUrl}}/api/internal/integrations/webhooks/PEGAR_WEBHOOK_ID/deliveries

### Gestión de API Keys

### Listar
GET {{baseUrl}}/api/internal/integrations/api-keys

### Crear
POST {{baseUrl}}/api/internal/integrations/api-keys
Content-Type: application/json

{
  "name": "Key de solo lectura",
  "scopes": ["products:read", "orders:read"]
}